# Copy to .env for local runs; on a host, set these as environment variables (secrets for the keys).
# Comments stay on their own lines: `docker run --env-file` does not strip trailing ones.

# --- Required
OPENAI_API_KEY=
TAVILY_API_KEY=
# Secret salt for hashed client addresses. Changing it resets every visitor's quota.
#   python -c "import secrets; print(secrets.token_hex(32))"
SDR_CLIENT_SALT=

# --- Optional (defaults shown)
# Open /#developer=<key> once for runs without limits; unset disables developer access.
# SDR_DEVELOPER_KEY=
# OPENAI_MODEL_NAME=gpt-5.4-mini
# SDR_MAX_REWRITES=2
# SQLite database; the Docker image uses /data/sdr.sqlite3.
# SDR_DB_PATH=data/sdr.sqlite3
# Built frontend served at /; set in the Docker image.
# SDR_STATIC_DIR=frontend/dist
# Visitor quota per client address: rolling 24 hours and 30 days.
# SDR_RUNS_PER_DAY=3
# SDR_RUNS_PER_MONTH=10
# Service budget per calendar month (UTC): model spending and Tavily credits.
# SDR_MONTHLY_MODEL_USD=5
# SDR_MONTHLY_SEARCH_CREDITS=750
# Runs in progress at once, for the whole server.
# SDR_MAX_CONCURRENT_RUNS=4

# --- Docker image only
# Reverse proxy addresses whose X-Forwarded-For uvicorn trusts. Without the right value
# every visitor looks like the proxy and shares one quota.
# FORWARDED_ALLOW_IPS=127.0.0.1
